{
  "manifest_version": 2,
  "id": "org.mai-mai.file-reader",
  "version": "1.4.0",
  "name": "文件读取（File Reader）",
  "description": "解析 QQ 群/私聊上传的文件（pdf/docx/xlsx/pptx/odt/epub/html/ipynb/csv/代码/文本等），分块后做「向量 + BM25 词法」混合检索（RRF 融合），把最相关内容注入 LLM 上下文，实现低开销的文件问答。支持追问改写、解析失败原因回传模型、文件滑动续期。URL 类文件下载默认只允许 QQ 文件域并拒绝内网/回环地址（可配置）。参考 astrbot_plugin_file_reader_pro 移植。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/file-reader"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.21.99"
  },
  "plugin_type": "data",
  "dependencies": [
    {
      "type": "python_package",
      "name": "numpy",
      "version_spec": ">=1.24"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24"
    },
    {
      "type": "python_package",
      "name": "pdfminer.six",
      "version_spec": ">=20221105"
    },
    {
      "type": "python_package",
      "name": "pypdfium2",
      "version_spec": ">=4.30"
    }
  ],
  "capabilities": [
    "send.text",
    "llm.embed",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
