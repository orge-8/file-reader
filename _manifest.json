{
  "manifest_version": 2,
  "id": "org.mai-mai.file-reader",
  "version": "1.0.18",
  "name": "文件读取（File Reader）",
  "description": "解析 QQ 群/私聊上传的文件（pdf/docx/xlsx/pptx/csv/代码/文本等），分块向量化后按语义检索，把最相关内容注入 LLM 上下文，实现低开销的文件问答。参考 astrbot_plugin_file_reader_pro 移植。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/maibot-file-reader"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "numpy",
      "version_spec": ">=1.24"
    }
  ],
  "capabilities": [
    "send.text",
    "llm.embed",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
